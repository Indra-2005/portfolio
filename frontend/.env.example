# ==============================================================================
# Frontend Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Backend API base URL
VITE_API_URL=http://localhost:8000/api/v1

# Configurable Canonical Website URL (Used for SEO canonical links, Open Graph, and JSON-LD)
# In development, defaults to current host (e.g. http://localhost:5173).
# Configure with production domain during deployment.
VITE_SITE_URL=http://localhost:5173

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Leave empty to keep analytics completely disabled.
VITE_GA_MEASUREMENT_ID=
