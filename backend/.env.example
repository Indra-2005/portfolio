# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit real secrets or production passwords to source control.
# ==============================================================================

# Application Settings
PROJECT_NAME="Portfolio API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"

# CORS Configuration (JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
