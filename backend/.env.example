# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit real secrets or production passwords to source control.
# ==============================================================================

# Application Settings
PROJECT_NAME="Portfolio API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"

# CORS Configuration (JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Authentication & Security
# WARNING: In production (ENVIRONMENT="production"), startup will FAIL if SECRET_KEY
# is left as default or contains insecure placeholder words.
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY="development-only-insecure-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Settings for JWT Authentication
AUTH_COOKIE_NAME="access_token"
COOKIE_SECURE=False       # Set to True in production over HTTPS
COOKIE_SAMESITE="lax"     # lax or strict
